{
    "name": "focusgate-monorepo",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "devDependencies": {
        "@supabase/supabase-js": "^2.39.3",
        "@tanstack/react-query": "^5.17.15",
        "typescript": "^5.3.3"
    },
    "scripts": {
        "install:all": "pnpm install",
        "build:mobile": "cd packages/mobile && pnpm build",
        "build:web": "cd packages/web && pnpm build",
        "dev:mobile": "cd packages/mobile && pnpm start",
        "dev:web": "cd packages/web && pnpm dev"
    }
}
