{
    "manifest_version": 3,
    "name": "FocusGate",
    "version": "1.0",
    "description": "Intelligent App & URL Blocker with Dynamic Block Screen",
    "permissions": ["activeTab", "storage", "scripting"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "FocusGate"
    }
}
